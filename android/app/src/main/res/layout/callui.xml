<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="32dp"
    android:background="#111">
    <TextView android:id="@+id/rufnummer" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="#fff"
        android:textSize="28sp" android:textStyle="bold" android:text="Anruf" />
    <TextView android:id="@+id/call_status" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="#aaa"
        android:textSize="16sp" android:layout_marginTop="12dp"
        android:gravity="center" android:text="..." />
    <Button android:id="@+id/btn_annehmen" android:layout_width="220dp"
        android:layout_height="wrap_content" android:layout_marginTop="40dp"
        android:text="📞 Annehmen" />
    <Button android:id="@+id/btn_ki_uebernehmen" android:layout_width="220dp"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="🤖 Gemma soll rangehen" />
    <Button android:id="@+id/btn_auflegen" android:layout_width="220dp"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="❌ Auflegen" />
</LinearLayout>

# /opt/callagent/sip.env  (chmod 600, root)  -  danach: /opt/callagent/sip/sip-konfig.sh
# Modus: aus | fritzbox | anbieter
SIP_MODUS=aus

# --- SIP-Zugang (Registrierung) ---
# fritzbox: SIP_SERVER=192.168.178.1, SIP_USER=<Benutzername des IP-Telefons>, SIP_PASS=<Kennwort>
# anbieter: Werte aus dem Kundenportal (Registrar, SIP-ID, SIP-Passwort)
SIP_SERVER=
SIP_PORT=5060
SIP_USER=
SIP_AUTH_USER=
SIP_PASS=
SIP_DOMAIN=
# Eigene Rufnummer (nur fuer Anzeige/Log)
SIP_NUMMER=
# Absender-IP fuer SIP/RTP (fritzbox: 192.168.178.202 = gemivo im FritzBox-WireGuard)
SIP_BIND_IP=
# Ausgehende Codecs (Telefonnetz: alaw zuerst)
SIP_CODECS=alaw,ulaw

# --- optional: sipgate REST-API (nur mit sipgate-Konto, Personal Access Token) ---
# Token-ID + Token aus app.sipgate.com > Persoenliche Zugangstoken; Scopes: history:read, devices:read, numbers:read
SIPGATE_TOKEN_ID=
SIPGATE_TOKEN=

# --- optional: FritzBox-API (TR-064, gratis): Anrufliste + Rufumleitung ---
FRITZ_HOST=192.168.178.1
FRITZ_USER=
FRITZ_PASS=

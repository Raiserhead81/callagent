[Unit]
Description=CallAgent SIP-Bruecke (Asterisk AudioSocket <-> Gemma-Backend)
After=network.target callagent.service asterisk.service
Wants=asterisk.service

[Service]
Type=simple
ExecStart=/opt/callagent/sip-venv/bin/python /opt/callagent/sip/callagent_sip.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
